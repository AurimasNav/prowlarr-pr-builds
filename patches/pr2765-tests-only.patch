+        public void should_parse_lostfilm_dates_without_russian_culture_data(string text, int year, int month, int day)
+        {
+            // Regression: dates were parsed with the ru-RU culture, which silently behaves like the
+            // invariant culture when only English ICU data is installed (e.g. the linuxserver.io
+            // Alpine image), so "08.04.2022" became August 4th and month names fell back to now.
+            LostFilm.ParseRussianDate(text).Should().Be(new DateTime(year, month, day));
+        }
